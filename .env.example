# PostgreSQL / Neon
DATABASE_URL="postgresql://company_user:company_password@company-host/exown?schema=public"
DIRECT_URL="postgresql://company_user:company_password@company-host/exown?schema=public"

# Firebase Client
NEXT_PUBLIC_FIREBASE_API_KEY="company-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="company-firebase-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="company-firebase-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="company-firebase-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="company-firebase-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="company-firebase-web-app-id"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="company-firebase-web-push-vapid-key"

# Firebase Admin
FIREBASE_PROJECT_ID="company-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@company-firebase-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\ncompany-service-account-private-key\n-----END PRIVATE KEY-----\n"

# Cloudinary
CLOUDINARY_URL="cloudinary://company-api-key:company-api-secret@company-cloud-name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="company-cloud-name"

# Razorpay
RAZORPAY_KEY_ID="company-razorpay-key-id"
RAZORPAY_KEY_SECRET="company-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="company-razorpay-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="company-razorpay-key-id"

# AI
GEMINI_API_KEY="company-gemini-api-key"

# Comma-separated server-side admin email allowlist
ADMIN_EMAILS="admin@company-domain.com"
